# Copy this file to ".env" and fill it in. Never commit your real .env.

# Required - get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=123456789:put-your-token-here

# Which AI backend: mock | ollama | groq | openai | anthropic
#   mock    -> offline canned replies, no key (default)
#   ollama  -> FREE, local. Needs Ollama running + a model pulled (e.g. llama3.2)
#   groq    -> FREE cloud tier, very fast. Needs GROQ_API_KEY
#   openai  -> paid. Needs OPENAI_API_KEY
#   anthropic -> paid. Needs ANTHROPIC_API_KEY
AI_PROVIDER=mock

# Optional: override the model for the chosen provider
# AI_MODEL=llama3.2

# Keys (only the one for your chosen provider is needed)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
