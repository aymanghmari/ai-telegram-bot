# Copy this file to ".env" and fill it in. Never commit your real .env.

# Required — get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=123456789:put-your-token-here

# Which AI backend to use: mock | openai | anthropic
# "mock" runs offline with canned replies — no key needed, great for a first test.
AI_PROVIDER=mock

# Only needed if AI_PROVIDER is openai / anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
